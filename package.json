{
  "name": "studyops-bot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs/wiki"
  ],
  "scripts": {
    "dev:client": "pnpm --filter studyops-client dev",
    "dev:server": "pnpm --filter studyops-server dev",
    "dev:server:prod-preview": "pnpm --filter studyops-server dev:prod-preview",
    "dev": "echo 'run pnpm dev:server and pnpm dev:client in separate terminals'",
    "build:shared": "pnpm --filter @studyops/shared build",
    "build:server": "pnpm --filter studyops-server build",
    "build:client": "pnpm --filter studyops-client build",
    "build": "pnpm build:shared && pnpm build:server && pnpm build:client",
    "typecheck:shared": "pnpm --filter @studyops/shared typecheck",
    "typecheck:server": "pnpm --filter studyops-server typecheck",
    "typecheck:client": "pnpm --filter studyops-client typecheck",
    "typecheck": "pnpm typecheck:shared && pnpm typecheck:server && pnpm typecheck:client",
    "test:server": "vitest run apps/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "types:server": "pnpm --filter studyops-server types",
    "deploy": "pnpm --filter studyops-server deploy",
    "deploy:production": "pnpm --filter studyops-server deploy:production",
    "deploy:client:dev": "pnpm --filter studyops-client deploy:dev",
    "deploy:client:prod": "pnpm --filter studyops-client deploy:prod",
    "db:generate": "pnpm --filter studyops-server db:generate",
    "db:apply:dev": "pnpm --filter studyops-server db:apply:dev",
    "db:apply:prod": "pnpm --filter studyops-server db:apply:prod",
    "db:list": "pnpm --filter studyops-server db:list",
    "secrets:check": "pnpm --filter studyops-server secrets:check",
    "wiki:index": "pnpm --filter @studyops/wiki index",
    "wiki:dev": "pnpm --filter @studyops/wiki dev",
    "wiki:build": "pnpm --filter @studyops/wiki build",
    "wiki:preview": "pnpm --filter @studyops/wiki preview",
    "wiki:watch": "pnpm --filter @studyops/wiki watch",
    "wiki:install-daemon": "pnpm --filter @studyops/wiki install-daemon",
    "wiki:uninstall-daemon": "pnpm --filter @studyops/wiki uninstall-daemon"
  },
  "devDependencies": {
    "fake-indexeddb": "^5.0.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
