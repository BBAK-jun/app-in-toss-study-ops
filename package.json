{
  "name": "studyops-bot",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs/wiki"
  ],
  "scripts": {
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run dev -w apps/server",
    "dev": "echo 'run npm run dev:server and npm run dev:client in separate terminals'",
    "build:shared": "npm run build -w packages/shared",
    "build:server": "npm run build -w apps/server",
    "build:client": "npm run build -w apps/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "typecheck:shared": "npm run typecheck -w packages/shared",
    "typecheck:server": "npm run typecheck -w apps/server",
    "typecheck:client": "npm run typecheck -w apps/client",
    "typecheck": "npm run typecheck:shared && npm run typecheck:server && npm run typecheck:client",
    "db:generate": "npm run db:generate -w apps/server",
    "db:apply:local": "npm run db:apply:local -w apps/server",
    "db:apply:remote": "npm run db:apply:remote -w apps/server",
    "wiki:index": "npm run index -w docs/wiki",
    "wiki:dev": "npm run dev -w docs/wiki",
    "wiki:build": "npm run build -w docs/wiki",
    "wiki:preview": "npm run preview -w docs/wiki",
    "wiki:watch": "npm run watch -w docs/wiki",
    "wiki:install-daemon": "npm run install-daemon -w docs/wiki",
    "wiki:uninstall-daemon": "npm run uninstall-daemon -w docs/wiki"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
