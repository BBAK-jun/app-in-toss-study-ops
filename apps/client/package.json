{
  "name": "studyops-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "StudyOps Bot MVP — Apps-in-Toss WebView 클라이언트 (Vite + React 18 + TDS Mobile)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ait": "ait build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "ait build && ait deploy --profile dev",
    "deploy:prod": "ait build && ait deploy --profile prod",
    "keys:set:dev": "bash scripts/ait-keys.sh set dev",
    "keys:set:prod": "bash scripts/ait-keys.sh set prod",
    "keys:sync": "bash scripts/ait-keys.sh sync",
    "keys:list": "bash scripts/ait-keys.sh list",
    "keys:remove": "bash scripts/ait-keys.sh remove"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@toss/tds-mobile": "^2.5.0",
    "@toss/tds-mobile-ait": "^2.5.0",
    "@emotion/react": "^11.13.0",
    "@apps-in-toss/web-framework": "^2.10.5",
    "@studyops/shared": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
