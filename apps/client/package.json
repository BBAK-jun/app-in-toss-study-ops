{
  "name": "studyops-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "StudyOps Bot MVP — Apps-in-Toss WebView 클라이언트 (Vite + React 18 + TDS Mobile)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ait": "ait build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:dev": "VITE_APP_ENV=development VITE_API_BASE_URL=https://studyops-server.mountain-race.workers.dev ait build && ait deploy --profile dev",
    "deploy:prod": "VITE_APP_ENV=live VITE_API_BASE_URL=https://studyops-server-production.mountain-race.workers.dev ait build && ait deploy --profile prod",
    "keys:set:dev": "bash scripts/ait-keys.sh set dev",
    "keys:set:prod": "bash scripts/ait-keys.sh set prod",
    "keys:sync": "bash scripts/ait-keys.sh sync",
    "keys:list": "bash scripts/ait-keys.sh list",
    "keys:remove": "bash scripts/ait-keys.sh remove"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.10.5",
    "@emotion/react": "^11.13.0",
    "@studyops/shared": "workspace:*",
    "@toss/tds-mobile": "^2.5.0",
    "@toss/tds-mobile-ait": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^5.0.2",
    "idb-keyval": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
