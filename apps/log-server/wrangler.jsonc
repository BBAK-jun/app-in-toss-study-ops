{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studyops-log-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "ENVIRONMENT": "dev",
    "API_SERVER_URL": "http://localhost:8787"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studyops-logs-db-dev",
      "database_id": "3bb33835-e939-422b-9770-d112d08ae449",
      "migrations_dir": "src/db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "LOG_ARCHIVE",
      "bucket_name": "studyops-log-archive-dev"
    }
  ],

  "analytics_engine_datasets": [
    {
      "binding": "LOGS_ANALYTICS",
      "dataset": "studyops_logs_dev"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "env": {
    "production": {
      "name": "studyops-log-server-production",

      "vars": {
        "ENVIRONMENT": "production",
        "API_SERVER_URL": "https://studyops-server-production.mountain-race.workers.dev"
      },

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studyops-logs-db-prod",
          "database_id": "3bb33835-e939-422b-9770-d112d08ae449",
          "migrations_dir": "src/db/migrations"
        }
      ],

      "r2_buckets": [
        {
          "binding": "LOG_ARCHIVE",
          "bucket_name": "studyops-log-archive-prod"
        }
      ],

      "analytics_engine_datasets": [
        {
          "binding": "LOGS_ANALYTICS",
          "dataset": "studyops_logs_prod"
        }
      ]
    }
  }
}
