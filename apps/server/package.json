{
  "name": "studyops-server",
  "version": "0.0.0",
  "private": true,
  "description": "StudyOps Bot — Hono on Cloudflare Workers + D1 (Drizzle ORM)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:prod-preview": "npm run _warn:prod && wrangler dev --env production",
    "_warn:prod": "echo '⚠️  DEV:PROD-PREVIEW — This targets production D1 (--env production). Use only for testing against prod DB. Local sqlite NOT used.'",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:apply:dev": "wrangler d1 migrations apply studyops-db-dev --local",
    "db:apply:prod": "wrangler d1 migrations apply studyops-db-prod --remote",
    "db:list": "wrangler d1 list",
    "db:list-migrations:dev": "wrangler d1 migrations list studyops-db-dev --local",
    "db:list-migrations:prod": "wrangler d1 migrations list studyops-db-prod --remote",
    "secrets:check": "node scripts/secrets-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@studyops/shared": "*",
    "agents": "^0.19.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "zod": "^4.0.0",
    "zod3": "npm:zod@^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "drizzle-kit": "^0.28.0",
    "miniflare": "^4.20260722.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
