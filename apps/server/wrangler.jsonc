{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studyops-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Default environment: local development.
  // Production via `wrangler deploy --env production`. See ADR-006.
  // ALLOWED_ORIGINS: dev는 localhost 화이트리스트가 하드코딩되어 있어 var 불필요.
  // prod에서는 env.production.vars.ALLOWED_ORIGINS 에서 주입 (콤마 구분). ADR-011.
  // CLOUDFLARE_ACCOUNT_ID: AE SQL API 호출용 (ADR-013 Phase 3). secret 아님 — 대시보드 노출 ID.
  "vars": {
    "ENVIRONMENT": "dev",
    "TOSS_AUTH_MODE": "dev",
    "TOSS_API_BASE_URL": "https://apps-in-toss-api.toss.im",
    "CLOUDFLARE_ACCOUNT_ID": ""
  },

  // Local dev D1 — also used by `wrangler dev` for the local sqlite file.
  // Existing database repurposed as dev; see ADR-007.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studyops-db-dev",
      "database_id": "a0459919-418c-4563-bf8b-162eeff0396e",
      "migrations_dir": "src/db/migrations"
    }
  ],

  // Analytics Engine — OLAP metric tier (ADR-013). Free tier: 100k data points/day.
  // Dataset auto-created on first write. dev/prod 격리 by dataset name.
  // The binding exposes `writeDataPoint()` — non-blocking, no waitUntil needed.
  "analytics_engine_datasets": [
    {
      "binding": "LOGS_ANALYTICS",
      "dataset": "studyops_logs_dev"
    }
  ],

  // R2 — 장기 로그 아카이빙 (ADR-014). D1 retention 만료분을 Parquet/JSONL로 영구 보관.
  // 버킷은 `wrangler r2 bucket create studyops-log-archive-dev` 로 사전 생성 필요.
  // dev/prod 격리 by bucket name (ADR-007 패턴).
  // 본 Phase 1은 binding 선언만 — 실제 아카이빙 로직은 Phase 2에서.
  "r2_buckets": [
    {
      "binding": "LOG_ARCHIVE",
      "bucket_name": "studyops-log-archive-dev"
    }
  ],

  // Observability for logging + wrangler tail. See ADR-008.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Daily log retention cron — ADR-011. Runs at 03:00 UTC (12:00 KST).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "STUDYOPS_MCP", "class_name": "StudyOpsMcpAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StudyOpsMcpAgent"] }
  ],

  "env": {
    "production": {
      // Distinct name so bare `wrangler deploy` doesn't overwrite prod.
      "name": "studyops-server-production",

      // HARNESS §6.3: prod must run live auth. boot-check enforces this.
      "vars": {
        "ENVIRONMENT": "production",
        "TOSS_AUTH_MODE": "live",
        "TOSS_API_BASE_URL": "https://apps-in-toss-api.toss.im",
        // CORS 화이트리스트 — 콤마로 구분된 origin 리스트. ADR-011.
        // 실제 앱인토스 WebView origin들로 교체 필요. 미설정 시 모든 cross-origin 요청 거부.
        "ALLOWED_ORIGINS": "https://apps-in-toss.toss.im",
        // AE SQL API 호출용 account ID (ADR-013 Phase 3). 배포시 실제 값으로 override.
        "CLOUDFLARE_ACCOUNT_ID": ""
      },

      // Prod D1 — separate instance from dev. See ADR-007.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studyops-db-prod",
          "database_id": "ae6a0663-e1f8-4fe6-96d5-64c2b335c673",
          "migrations_dir": "src/db/migrations"
        }
      ],

      // Prod Analytics Engine dataset — ADR-013. Isolated from dev.
      "analytics_engine_datasets": [
        {
          "binding": "LOGS_ANALYTICS",
          "dataset": "studyops_logs_prod"
        }
      ],

      // Prod R2 bucket — ADR-014. 영구 보관 아카이브. 별도 버킷으로 dev와 격리.
      "r2_buckets": [
        {
          "binding": "LOG_ARCHIVE",
          "bucket_name": "studyops-log-archive-prod"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },

      // MCP DO binding — read-only tools for Sisyphus agent. See ADR-010.
      "durable_objects": {
        "bindings": [
          { "name": "STUDYOPS_MCP", "class_name": "StudyOpsMcpAgent" }
        ]
      },

      // Daily log retention cron — ADR-011. Inherited from top-level triggers.
      "triggers": {
        "crons": ["0 3 * * *"]
      }
    }
  }
}
