# 인증 모드: 'dev' (Toss API 스킵) | 'live' (실제 Toss OAuth2)
# dev 환경 기본값. 프로덕션은 wrangler.jsonc env.production.vars 에서 force: "live".
TOSS_AUTH_MODE=dev

# Toss API (live 모드에서만 사용)
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im

# 세션 JWT 서명 비밀키 (HS256). 로컬에서는 임의 문자열 32자 이상.
# 프로덕션: wrangler secret put SESSION_SECRET --env production
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# (옵션) 기본 Discord webhook — 개별 스터디에 webhook이 없을 때 폴백
DISCORD_WEBHOOK_DEFAULT=

# Analytics Engine SQL API (ADR-013 Phase 3). AE reads는 Cloudflare REST API 호출이므로
# 별도 토큰 필요. 로컬 dev에서 미설정시 /admin/logs/metrics → 503 ANALYTICS_ENGINE_ERROR.
#
# 토큰 권한: 최소 "Account.Analytics Read" 권한만 부여 (least privilege).
# 발급: Cloudflare Dashboard → My Profile → API Tokens → Create Token.
#   - Permissions: Account > Account Analytics : Read
#   - Account Resources: Include - Specific account - <본인 계정>
#
# 프로덕션은 wrangler secret 으로 등록:
#   npx wrangler secret put CF_API_TOKEN --env production
#
# CLOUDFLARE_ACCOUNT_ID는 wrangler.jsonc vars 로 이미 주입됨 (secret 아님).
CF_API_TOKEN=

# (선택) 환경 식별자 — wrangler.jsonc vars 가 주입하므로 보통 생략.
# 로컬에서 wrangler dev 시 .dev.vars 로도 오버라이드 가능:
# ENVIRONMENT=dev
# ENVIRONMENT=production (런타임 검증: boot-check 가 fail-fast throw — 주의)

# (live 프로덕션 전용) mTLS 인증서 — wrangler에 secret으로 바인딩
# TOSS_MTLS_CERT=...
# TOSS_MTLS_KEY=...
