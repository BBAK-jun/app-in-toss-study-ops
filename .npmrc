# pnpm 설정 — apps-in-toss WebView 번들러(Vite/Rollup)와 @apps-in-toss/web-framework가
# pnpm의 기본 symlink 구조에서 호환성 문제를 일으킴 (TS2742: declaration 시
# .pnpm/<hash>/... 경로를 non-portable로 판정). 따라서 npm 호환 hoisted 구조 사용.
#
# 향후 apps-in-toss 측에서 pnpm 공식 지원 시 isolated 모드 전환 가능:
#   1. 이 파일에서 node-linker=hoisted 제거
#   2. pnpm install --force
#   3. TS2742 등의 에러 확인 후 tsconfig에 preserveSymlinks: true 검토
node-linker=hoisted
