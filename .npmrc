# pnpm 설정 — npm/yarn 마이그레이션 직후 안정성 우선.
# Phase 5 이후 점진적으로 hoist 범위를 좁혀 strict 모드로 전환 예정.

# Vite, React, Emotion, TDS Mobile 등 프론트엔드 생태계는
# pnpm의 strict node_modules에서 종종 팬텀 디펜던시 이슈를 일으킴.
# 합리적인 기본 호이스팅 패턴으로 완화.
public-hoist-pattern[]=*vite*
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*emotion*
public-hoist-pattern[]=*tds-mobile*
public-hoist-pattern[]=@apps-in-toss/*

# Wrangler / Cloudflare Workers 빌드 타임 의존성도 동일하게 처리.
public-hoist-pattern[]=*wrangler*
public-hoist-pattern[]=*esbuild*
public-hoist-pattern[]=*drizzle*

# pnpm 10+ 부터 의존성 트리 밖의 패키지는 기본 build 스크립트를 실행하지 않음.
# 앱인토스 / Toss 패키지 중 postinstall이 필요할 수 있으므로 허용.
# 필요시 pnpm-workspace.yaml의 onlyBuiltDependencies 로 좁힐 것.
