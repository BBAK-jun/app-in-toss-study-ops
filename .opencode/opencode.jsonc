// OpenCode 프로젝트 구성 — StudyOps Bot
// 이 파일은 OpenCode가 프로젝트별로 동작 방식을 결정합니다.
//
// 참고: 이전 버전의 opencode.jsonc에는 OpenCode가 인식하지 못하는 커스텀 키
// (name, hooks, skillRouting, mcpWhitelist, forbiddenActions, sessionState, wiki)가
// 포함되어 있어 설정 검증 오류가 발생했습니다. 해당 커스텀 메타데이터는
// project-conventions.md 로 분리 보존했으며, 아래에는 OpenCode 스키마에 맞는
// 유효한 키만 남겼습니다. 원본은 opencode.jsonc.bak 로 백업되어 있습니다.

{
  "$schema": "https://opencode.ai/config.json",

  // 프로젝트 수준 지시어 — 에이전트가 매 세션마다 참조
  "instructions": [
    "Read .opencode/project-conventions.md for project workflow rules, skill routing, and forbidden actions.",
    "HARNESS.md is the execution contract — load it at session start for current sprint context.",
    "Never use 'as any', '@ts-ignore', or 'localStorage'. Use type guards, fix TS errors, and use sessionStorage.",
    "Deployment (`wrangler deploy`) and `git push` require explicit user approval.",
    "Use the `codegraph` MCP server before editing existing symbols."
  ],

  // MCP 서버 — 화이트리스트는 project-conventions.md 참고
  "mcp": {
    "codegraph": {
      "enabled": true
    },
    "context7": {
      "enabled": true
    },
    "playwright": {
      "enabled": true
    }
  },

  // 도구 권한 — 위험한 작업은 확인 후 실행
  "permission": {
    "bash": {
      "wrangler deploy": "ask",
      "git push": "ask"
    }
  },

  // 스냅샷 자동 저장
  "snapshot": true
}
